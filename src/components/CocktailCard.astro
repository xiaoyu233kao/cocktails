---
import { withBase, cocktailPath } from '../lib/paths';
import { labelFor } from '../lib/labels';
import { flavorGroups, groupLabel, groupValuesForEntry, styleGroups } from '../lib/taxonomy';

interface Props {
  entry: any;
}

const { entry } = Astro.props;
const { data } = entry;
const detailUrl = cocktailPath(data.slug);
const imageUrl = withBase(data.image);
const flavorGroupIds = groupValuesForEntry(data, flavorGroups, 'flavors');
const styleGroupIds = groupValuesForEntry(data, styleGroups, 'styles');
const flavorGroupLabels = flavorGroupIds.map((value) => groupLabel(value, flavorGroups));
const search = [
  data.nameZh,
  data.nameEn,
  data.category,
  data.baseSpirit,
  ...data.flavors,
  ...data.styles,
  ...data.tags,
  ...data.ingredients.flatMap((item: any) => [item.nameZh, item.nameEn, ...item.aliases]),
].join(' ');
---
<article
  class="cocktail-card"
  data-cocktail-card
  data-base={data.baseSpirit}
  data-flavors={data.flavors.join(',')}
  data-styles={data.styles.join(',')}
  data-flavor-groups={flavorGroupIds.join(',')}
  data-style-groups={styleGroupIds.join(',')}
  data-ingredients={data.ingredients.flatMap((item: any) => [item.nameZh, item.nameEn, ...item.aliases]).join('|')}
  data-search={search}
>
  <a
    class="card-media"
    href={detailUrl}
    aria-label={`查看${data.nameZh}配方`}
  >
    <img src={imageUrl} alt={data.imageAlt} loading="lazy" width="1200" height="900" />
    <span class="card-zoom-label">查看配方</span>
  </a>
  <a class="card-body card-body-link" href={detailUrl} aria-label={`查看${data.nameZh}配方`}>
    <div class="card-kicker">{labelFor(data.baseSpirit)} · {data.category}</div>
    <h2 class="card-title">{data.nameZh}</h2>
    <div class="card-subtitle">{data.nameEn}</div>
    <div class="card-tags">
      {flavorGroupLabels.slice(0, 2).map((tag: string) => <span class="tag">{tag}</span>)}
    </div>
  </a>
</article>
