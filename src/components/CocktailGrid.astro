---
import CocktailCard from './CocktailCard.astro';

interface Props {
  entries: any[];
  indexUrl?: string;
}

const { entries, indexUrl } = Astro.props;
---
<div class="cocktail-grid" data-cocktail-grid data-recipes-index={indexUrl}>
  {entries.map((entry) => <CocktailCard entry={entry} />)}
</div>
