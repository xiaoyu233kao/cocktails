---
import { withBase } from '../lib/paths';

const fallbackImage = withBase('images/cocktails/placeholder.svg');
---
<dialog class="lightbox" id="cocktail-lightbox" aria-labelledby="lightbox-caption">
  <div class="lightbox-frame">
    <button class="lightbox-control lightbox-close" type="button" data-lightbox-close aria-label="关闭图片预览">×</button>
    <button class="lightbox-control" type="button" data-lightbox-prev aria-label="上一张图片">‹</button>
    <figure class="lightbox-figure">
      <img data-lightbox-image src="" alt="" />
      <figcaption class="lightbox-caption" id="lightbox-caption" data-lightbox-caption></figcaption>
      <div class="lightbox-status" data-lightbox-status aria-live="polite"></div>
    </figure>
    <button class="lightbox-control" type="button" data-lightbox-next aria-label="下一张图片">›</button>
  </div>
</dialog>
<script define:vars={{ fallbackImage }}>
  // @ts-nocheck
  const dialog = document.querySelector('#cocktail-lightbox');
  const image = dialog?.querySelector('[data-lightbox-image]');
  const caption = dialog?.querySelector('[data-lightbox-caption]');
  const status = dialog?.querySelector('[data-lightbox-status]');
  const close = dialog?.querySelector('[data-lightbox-close]');
  const previous = dialog?.querySelector('[data-lightbox-prev]');
  const next = dialog?.querySelector('[data-lightbox-next]');
  let triggers = [];
  let current = 0;
  let returnFocus = null;

  // Keep text and controls usable when an optional asset is unavailable.
  document.addEventListener('error', (event) => {
    const target = event.target;
    if (target instanceof HTMLImageElement && !target.dataset.fallback) {
      target.dataset.fallback = 'true';
      target.src = fallbackImage;
    }
  }, true);

  const refreshTriggers = () => {
    triggers = [...document.querySelectorAll('[data-lightbox-src]')]
      .filter((trigger) => !trigger.closest('[data-cocktail-card][hidden]'));
  };

  const show = (index) => {
    if (!dialog || !image || !caption || !status || !triggers.length) return;
    current = (index + triggers.length) % triggers.length;
    const trigger = triggers[current];
    image.src = trigger.dataset.lightboxSrc || '';
    image.alt = trigger.dataset.lightboxAlt || '';
    caption.textContent = trigger.dataset.lightboxCaption || '';
    status.textContent = triggers.length > 1 ? `${current + 1} / ${triggers.length}` : '';
    previous?.toggleAttribute('hidden', triggers.length <= 1);
    next?.toggleAttribute('hidden', triggers.length <= 1);
    if (!dialog.open) dialog.showModal();
    close?.focus();
  };

  refreshTriggers();
  document.addEventListener('click', (event) => {
    const target = event.target.closest('[data-lightbox-src]');
    if (!target) return;
    event.preventDefault();
    refreshTriggers();
    returnFocus = target;
    show(triggers.indexOf(target));
  });

  close?.addEventListener('click', () => {
    dialog?.close();
    returnFocus?.focus();
  });
  previous?.addEventListener('click', () => show(current - 1));
  next?.addEventListener('click', () => show(current + 1));
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) {
      dialog.close();
      returnFocus?.focus();
    }
  });
  document.addEventListener('keydown', (event) => {
    if (!dialog?.open) return;
    if (event.key === 'ArrowLeft') show(current - 1);
    if (event.key === 'ArrowRight') show(current + 1);
    if (event.key === 'Escape') {
      dialog.close();
      returnFocus?.focus();
    }
  });
</script>
