---
import { getCollection } from 'astro:content';
import RecipeCatalogPage from '../../components/RecipeCatalogPage.astro';

const pageSize = 60;
const entries = (await getCollection('cocktails')).sort((a, b) => a.data.nameEn.localeCompare(b.data.nameEn));
---
<RecipeCatalogPage entries={entries} pageEntries={entries.slice(0, pageSize)} pageNumber={1} totalPages={Math.ceil(entries.length / pageSize)} />
